# Vidyra Backend Environment Configuration

# Security & Secrets
JWT_SECRET=your_vidyra_jwt_secret_here
SECRET_KEY=your_vidyra_secret_key_here
FERNET_KEY=your_vidyra_fernet_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie-based Authentication
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_ACCESS_NAME=vidyra_access_token
AUTH_COOKIE_REFRESH_NAME=vidyra_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# CSRF (Double-Submit Token)
CSRF_PROTECTION_ENABLED=true
CSRF_COOKIE_NAME=vidyra_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Database (PostgreSQL with pgvector, e.g., Supabase / Neon / Local)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/vidyra_db

# Google OAuth 2.0 (Google Classroom / Drive integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://vidyra-api.onrender.com/auth/callback

# File Storage
UPLOAD_DIR=./uploads

# AI Provider API Keys
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_from_aistudio
# Optional fallback if using Nomic instead of Gemini
NOMIC_API_KEY=your_nomic_api_key_here

# Vector Retrieval Settings (pgvector)
VECTOR_EMBEDDING_DIM=768
PGVECTOR_ENABLE_FTS_GIN_INDEX=true
PGVECTOR_ENABLE_HNSW=true
PGVECTOR_AUTO_MIGRATE_VECTOR_DIMENSION=true
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64

# Frontend URL & CORS
FRONTEND_URL=https://vidyra.vercel.app
CLIENT_URL=https://vidyra.vercel.app
FRONTEND_AUTH_CALLBACK_PATH=/auth/callback
BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://vidyra.vercel.app"]

# RAG & Debug Flags
RAG_ENABLE_RERANK=false
PDF_EXTRACT_IMAGES=false
DEBUG=false
