# Vidyra Client Environment Configuration

# Public backend URL used by client components
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Server-side backend URL for Next.js API routes / BFF proxy
BACKEND_URL=http://localhost:8000

# Cookie name used by frontend auth routes to hold backend OAuth state
BFF_BACKEND_SESSION_COOKIE_NAME=session

# Authentication Cookie & CSRF Configuration (must match backend settings)
NEXT_PUBLIC_CSRF_COOKIE_NAME=vidyra_csrf_token
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_ACCESS_NAME=vidyra_access_token
AUTH_COOKIE_REFRESH_NAME=vidyra_refresh_token

# Notes:
# - In production, set NEXT_PUBLIC_BACKEND_URL and BACKEND_URL to your deployed server URL (e.g. https://vidyra-api.onrender.com)
# - Ensure Google Cloud Console OAuth redirect URI matches: https://<your-frontend-domain>/api/auth/callback
